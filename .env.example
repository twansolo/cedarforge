# Cedar Forge.AI environment variables
#
# Copy to .env.local for local development. Every value here is server-only:
# none are prefixed with NEXT_PUBLIC_, so they never reach the client bundle.
# In production set these in Vercel under Project Settings → Environment Variables.

# ── Contact form delivery ────────────────────────────────────────────────────
# The /api/contact route checks these in order. With none set, submissions are
# validated and logged server-side and the form reports a development response.

# Option 1 — transactional email via Resend. All three are required together.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option 2 — generic JSON webhook for another CRM, Zapier, or Make scenario.
CONTACT_WEBHOOK_URL=

# ── HubSpot ──────────────────────────────────────────────────────────────────
# Creates the contact in HubSpot via the Forms API, which is available on the
# free tier. This runs in addition to any option above, so the CRM keeps every
# lead even when email delivery is also configured.
#
# The portal id lives in src/lib/site.ts because it is public. Only the form id
# belongs here.
#
# Setup, in HubSpot:
#   1. Marketing → Forms → create a form (a blank/embedded form is fine).
#   2. Add exactly these fields, using their default internal names:
#      firstname, lastname, email, company, website, message
#   3. Publish it, then copy the form id (the guid in the form's editor URL)
#      into HUBSPOT_FORM_GUID below.
#
# Submissions are rejected with a 400 if a field sent by the route is missing
# from the form, so the field list above has to match. See
# src/lib/hubspot-forms.ts for the mapping.
HUBSPOT_FORM_GUID=

# Private app access token, used by the admin Leads tool to read contacts back
# out of the CRM. This is a different credential from the form guid above: the
# Forms API grants write-only lead capture and no read access at all.
#
# Setup, in HubSpot:
#   1. Settings → Integrations → Private Apps → Create a private app.
#   2. Scopes tab → enable crm.objects.contacts.read. Nothing else: the tool
#      only reads, so a token without write scopes cannot damage the CRM even
#      if it leaks.
#   3. Copy the access token here.
#
# Private apps are available on the free tier. Leaving this unset is fine — the
# Leads tool renders setup instructions instead of failing. See
# src/lib/hubspot-crm.ts.
HUBSPOT_PRIVATE_APP_TOKEN=

# Optional. Separate form for the free Systems Snapshot popup, so the free and
# paid intents report separately in HubSpot. It takes the same six fields as
# above. Left empty, Snapshot requests go to HUBSPOT_FORM_GUID instead and the
# intent is recorded in the message body.
HUBSPOT_SNAPSHOT_FORM_GUID=

# ── Admin area (/admin) ──────────────────────────────────────────────────────
# Both values are required before /admin will accept a sign-in. With either
# missing the area stays locked: no session can be issued or verified.
#
# Generate both at once, without putting the password in your shell history:
#
#   npm run admin:hash
#
# ADMIN_PASSWORD_HASH is a salted scrypt digest, safe to store in a hosting
# provider's environment variables. The password itself is never stored.
# Changing this value invalidates every existing session, which is how you
# revoke access remotely.
ADMIN_PASSWORD_HASH=

# HMAC key for the admin session cookie. Minimum 32 characters. Replacing it
# signs everyone out. Generate independently with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
