# Cedar Forge.AI environment variables
#
# Copy to .env.local for local development. Every value here is server-only:
# none are prefixed with NEXT_PUBLIC_, so they never reach the client bundle.
# In production set these in Vercel under Project Settings → Environment Variables.

# ── Contact form delivery ────────────────────────────────────────────────────
# The /api/contact route checks these in order. With none set, submissions are
# validated and logged server-side and the form reports a development response.

# Option 1 — transactional email via Resend. All three are required together.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option 2 — generic JSON webhook for a CRM, HubSpot workflow, Zapier, or Make.
CONTACT_WEBHOOK_URL=
